# ══════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DEL BOT — copia este archivo como .env y rellena tus valores
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── PASO 1: Token de tu bot de Telegram ───────────────────────────────────────
# 1. Abre Telegram y busca @BotFather
# 2. Escribe /newbot y sigue los pasos (elige nombre y username)
# 3. BotFather te dará un token con el formato: 123456789:AAxxxxxxx...
# 4. Pégalo aquí:
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PASO 2: Tu Chat ID ────────────────────────────────────────────────────────
# 1. Busca @userinfobot en Telegram
# 2. Escribe /start
# 3. Te mostrará tu ID numérico (ej. 987654321)
# 4. Pégalo aquí:
CHAT_ID=987654321

# ── PASO 3: API Key de The Odds API ───────────────────────────────────────────
# 1. Regístrate GRATIS en https://the-odds-api.com
# 2. En tu dashboard encontrarás tu API key
# 3. El plan gratuito incluye 500 peticiones/mes (suficiente para uso normal)
# 4. Pégala aquí:
ODDS_API_KEY=tu_api_key_aqui

# ── Configuración opcional ────────────────────────────────────────────────────
MIN_ODDS=2.0
CHECK_INTERVAL=10800
